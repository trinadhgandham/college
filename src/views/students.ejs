<!doctype html><html><head><title>Students</title><link rel="stylesheet" href="/css/style.css"></head><body><nav><b>College QR Attendance</b><a href="/dashboard">Dashboard</a><a href="/students">Students</a><a href="/events">Events</a><a href="/scanner">Scanner</a><a href="/attendance">Live</a><form method="post" action="/logout"><button>Logout</button></form></nav><main><h1>Student Management</h1><% if(flash){ %><div class="alert <%= flash.type %>"><%= flash.msg %></div><% } %><form class="panel" method="post" action="/students"><input name="student_no" placeholder="Student No" required><input name="name" placeholder="Full name" required><input name="email" type="email" placeholder="Email" required><input name="department" placeholder="Department" required><input name="year_level" placeholder="Year Level" required><input name="phone" placeholder="Phone"><button>Add Student</button></form><table><tr><th>No.</th><th>Name</th><th>Email</th><th>Department</th><th>Year</th><th></th></tr><% students.forEach(s=>{ %><tr><td><%= s.student_no %></td><td><%= s.name %></td><td><%= s.email %></td><td><%= s.department %></td><td><%= s.year_level %></td><td><form method="post" action="/students/<%= s.id %>/delete"><button class="danger">Delete</button></form></td></tr><% }) %></table></main></body></html>
