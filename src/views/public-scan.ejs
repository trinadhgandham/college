<!doctype html><html><head><title>Event Check-in</title><link rel="stylesheet" href="/css/style.css"></head><body class="auth"><main class="card login"><% if(!event){ %><h1>Invalid or closed event</h1><% } else { %><h1><%= event.title %></h1><p><%= event.venue %></p><form id="checkin"><input type="hidden" id="token" value="<%= event.qr_token %>"><label>Student Number<input id="student_no" required autofocus></label><button>Check in</button></form><div id="result"></div><% } %></main><script src="/js/scanner.js"></script></body></html>
