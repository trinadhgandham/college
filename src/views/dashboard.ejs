<!doctype html><html><head><title>Dashboard</title><link rel="stylesheet" href="/css/style.css"></head><body><nav><b>College QR Attendance</b><a href="/dashboard">Dashboard</a><a href="/students">Students</a><a href="/events">Events</a><a href="/scanner">Scanner</a><a href="/attendance">Live</a><form method="post" action="/logout"><button>Logout</button></form></nav><main><h1>Live Dashboard</h1><section class="grid"><div class="metric"><span><%= stats.students %></span>Students</div><div class="metric"><span><%= stats.events %></span>Events</div><div class="metric"><span><%= stats.active %></span>Active</div><div class="metric"><span><%= stats.attendance %></span>Check-ins</div></section><h2>Recent Attendance</h2><table><tr><th>Time</th><th>Event</th><th>Student</th><th>No.</th></tr><% recent.forEach(r=>{ %><tr><td><%= r.checked_in_at %></td><td><%= r.title %></td><td><%= r.name %></td><td><%= r.student_no %></td></tr><% }) %></table></main></body></html>
