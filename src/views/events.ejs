<!doctype html><html><head><title>Events</title><link rel="stylesheet" href="/css/style.css"></head><body><nav><b>College QR Attendance</b><a href="/dashboard">Dashboard</a><a href="/students">Students</a><a href="/events">Events</a><a href="/scanner">Scanner</a><a href="/attendance">Live</a><form method="post" action="/logout"><button>Logout</button></form></nav><main><h1>Event Management</h1><% if(flash){ %><div class="alert <%= flash.type %>"><%= flash.msg %></div><% } %><form class="panel" method="post" action="/events"><input name="title" placeholder="Event title" required><input name="venue" placeholder="Venue" required><input name="starts_at" type="datetime-local" required><input name="ends_at" type="datetime-local" required><textarea name="description" placeholder="Description"></textarea><button>Create Event</button></form><table><tr><th>Title</th><th>Schedule</th><th>Venue</th><th>Participants</th><th>Status</th><th>Actions</th></tr><% events.forEach(e=>{ %><tr><td><%= e.title %></td><td><%= e.starts_at %> - <%= e.ends_at %></td><td><%= e.venue %></td><td><%= e.attendees %></td><td><%= e.is_active?'Active':'Closed' %></td><td class="actions"><a href="/events/<%= e.id %>/qr">QR</a><a href="/reports/<%= e.id %>.xlsx">Excel</a><a href="/reports/<%= e.id %>.pdf">PDF</a><form method="post" action="/events/<%= e.id %>/toggle"><button>Toggle</button></form><form method="post" action="/events/<%= e.id %>/delete"><button class="danger">Delete</button></form></td></tr><% }) %></table></main></body></html>
